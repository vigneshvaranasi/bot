MODEL=gemini/gemini-2.0-flash-lite-001
GEMINI_API_KEY=

# Qdrant Vector Database Configuration
QDRANT_URL=
QDRANT_API_KEY=

# Redis Cache Configuration
# Enable/disable Redis caching (true/false)
USE_REDIS_CACHE=true

# Option 1: Use Redis URL (recommended for production)
# Format: redis://[username:password@]host:port[/db]
# Examples:
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://user:password@localhost:6379/0
# REDIS_URL=rediss://user:password@redis.example.com:6380/0
REDIS_URL=

# Option 2: Individual Redis settings (fallback if REDIS_URL not provided)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USERNAME=